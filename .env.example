# --- Окружение -------------------------------------------------------------
APP_ENV=local            # local | staging | production
LOG_LEVEL=INFO
DEBUG=false

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=visa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=visa_duty

# --- Redis (FSM aiogram) ---------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Telegram --------------------------------------------------------------
BOT_TOKEN=

# --- Учётные данные VFS (ТЗ §13, §21) --------------------------------------
# Сгенерировать: python -m app.cli generate-key
# Ключ НЕ должен попадать в репозиторий. Его смена делает сохранённые пароли
# нечитаемыми — их придётся ввести заново.
CREDENTIALS_KEY=

# --- Мониторинг ------------------------------------------------------------
SELECTORS_PATH=config/vfs_selectors.json
ARTIFACTS_DIR=artifacts
# Профили браузера по учётным записям. Здесь живёт сессия, полученная ручным
# входом: каталог обязан переживать перезапуск, иначе Turnstile придётся
# проходить заново после каждого рестарта.
PROFILES_DIR=profiles
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
# Глобальный выключатель (ТЗ §12 «остановить мониторинг»).
MONITORING_ENABLED=true

# --- Админ-панель ----------------------------------------------------------
# Смена ключа разлогинивает все активные сессии.
WEB_SECRET_KEY=change-me-to-a-long-random-string
WEB_SESSION_COOKIE=visa_duty_session
WEB_SESSION_TTL_HOURS=12
WEB_HOST=0.0.0.0
WEB_PORT=8000

# --- Планировщик -----------------------------------------------------------
SCHEDULER_TICK_SECONDS=60
LOCK_KEY_TASK_CREATION=815001
LOCK_KEY_ESCALATION=815002
LOCK_KEY_ACK_RECLAIM=815003
LOCK_KEY_WEBHOOK=815004

# --- Вебхук CRM ------------------------------------------------------------
WEBHOOK_TIMEOUT_SECONDS=10

# Пороги эскалаций, ID группового чата и URL вебхука здесь НЕ задаются:
# они редактируются в панели и хранятся в таблице settings.
